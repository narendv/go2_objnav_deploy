# Install required libraries
RUN apt-get update && apt-get install -y software-properties-common

RUN add-apt-repository ppa:ubuntu-toolchain-r/test -y && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    add-apt-repository universe -y

# Install OpenCV and other dependencies
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    python3-opencv=4.5.4+dfsg-9ubuntu4 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install Python packages
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install opencv-python tqdm zmq cuda-python numpy==1.26.1 flatbuffers

ENV OPENBLAS_CORETYPE=ARMV8

# # Install PyTorch for Jetson
ENV TORCH_INSTALL=https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/torch-2.4.0a0+07cecf4168.nv24.05.14710581-cp310-cp310-linux_aarch64.whl
RUN python3 -m pip install --no-cache-dir $TORCH_INSTALL

RUN echo "alias python=python3" >> ~/.bashrc

COPY libcudnn8_8.9.4.25-1+cuda12.2_arm64.deb /workspace/libcudnn8.deb

RUN dpkg -i /workspace/libcudnn8.deb && \
    apt-get install -f -y && \
    rm /workspace/libcudnn8.deb

RUN apt-get update && apt-get install -y libopenblas-dev


# Ros installation

RUN apt-get update && apt-get install -y software-properties-common && \
    add-apt-repository ppa:ubuntu-toolchain-r/test -y && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    add-apt-repository universe -y

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg

RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

RUN apt-get update && apt install -y ros-humble-desktop python3-argcomplete

WORKDIR /workspace/ws
COPY ws/src src

RUN apt-get update && apt install -y python3-colcon-common-extensions ros-humble-vision-msgs

RUN apt-get update

RUN /bin/bash -c '. /opt/ros/humble/setup.bash; colcon build'

RUN python3 -m pip install transforms3d

RUN apt-get update && apt-get install -y ros-humble-rmw-cyclonedds-cpp && \
    apt-get install -y ros-humble-rosidl-generator-dds-idl

WORKDIR /root
RUN git clone https://github.com/unitreerobotics/unitree_ros2
RUN cd ~/unitree_ros2/cyclonedds_ws/src && git clone https://github.com/ros2/rmw_cyclonedds -b humble && \
    git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x && cd .. && colcon build --packages-select cyclonedds

WORKDIR /root/unitree_ros2/cyclonedds_ws
RUN /bin/bash -c '. /opt/ros/humble/setup.bash; colcon build'

# RUN echo "Setup unitree ros2 environment" && \

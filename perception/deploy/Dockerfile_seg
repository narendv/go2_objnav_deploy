#     env"

RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    source $HOME/unitree_ros2/cyclonedds_ws/install/setup.bash"

ENV RMW_IMPLEMENTATION rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI '<CycloneDDS><Domain><General><Interfaces><NetworkInterface name="eth0" priority="default" multicast="default" /></Interfaces></General></Domain></CycloneDDS>'

RUN echo 'source /opt/ros/humble/setup.bash' >> ~/.bashrc
RUN echo 'source /root/unitree_ros2/cyclonedds_ws/install/setup.bash' >> ~/.bashrc
RUN echo 'source /workspace/ws/install/setup.bash' >> ~/.bashrc

RUN python3 -m pip uninstall -y tensorrt
RUN wget https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/10.3.0/local_repo/nv-tensorrt-local-tegra-repo-ubuntu2204-10.3.0-cuda-12.6_1.0-1_arm64.deb \
    && apt-key adv --fetch-keys https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/sbsa/3bf863cc.pub \
    && dpkg -i nv-tensorrt-local-tegra-repo-ubuntu2204-10.3.0-cuda-12.6_1.0-1_arm64.deb \
    && cp /var/nv-tensorrt-local-tegra-repo-ubuntu2204-10.3.0-cuda-12.5/*.gpg /usr/share/keyrings/ \
    && apt-get update && rm -rf nv-tensorrt-local-tegra-repo-ubuntu2204-10.3.0-cuda-12.6_1.0-1_arm64.deb \
    && apt-get install -y tensorrt

RUN python3 -m pip install scikit-learn
